# AI Trip Planner Environment Variables
# Copy this file to .env and fill in your API keys

# LLM API Keys (Required - at least one)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Search and Data APIs (Required)
SERPER_API_KEY=your_serper_api_key_here
SEARCHAPI_API_KEY=your_searchapi_api_key_here

# Weather API (Open-Meteo is free, no key needed)
# OPENWEATHER_API_KEY=your_openweather_api_key_here

# Vector Database (Optional)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment
CHROMA_PERSIST_DIRECTORY=./data/embeddings

# Database (Optional)
DATABASE_URL=sqlite:///./data/trip_planner.db
REDIS_URL=redis://localhost:6379

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here
PROMETHEUS_PORT=8000

# Application Settings
LOG_LEVEL=INFO
DEBUG=False
MAX_CONCURRENT_AGENTS=5
DEFAULT_TIMEOUT=30
